// Bağışlar & resmi bağış bildirimleri (Faz 5 — Zuwendungsbestätigung).
//
// KARAR: Modüller arası FK YOK — Donation.donorId, ZuwendungConfirmation.memberId
// düz id + anlık görüntü etiketleri. Para Decimal(12,2) kalıcılıkta; aritmetik
// integer cent (shared/money.ts).
//
// Değişmezlik (§ 10): Donation, ZuwendungConfirmation ve Item ASLA sert silinmez
// (BEFORE DELETE tetikleyicileri); bildirimin korunan kolonları UPDATE'te
// değiştirilemez; Item'da yalnızca activeKey (ISSUED → NULL) değişebilir.

enum DonorType {
  PERSON // Kişi
  ORGANIZATION // Kuruluş
}

enum DonationMethod {
  CASH // Nakit
  BANK_TRANSFER // Banka havalesi
  CARD // Kart
  PAYPAL // PayPal
  REIMBURSEMENT_WAIVER // Aufwandsspende (gider vazgeçimi) — bu yöntemle ZORUNLU
  OTHER // Diğer
}

enum ConfirmationKind {
  SINGLE // Einzelbestätigung
  COLLECTIVE // Sammelbestätigung
}

enum ConfirmationContent {
  DONATION // Geldzuwendungen
  MEMBERSHIP_FEE // Mitgliedsbeiträge
}

enum ConfirmationStatus {
  ISSUED
  CANCELLED
}

enum ConfirmationItemType {
  DONATION // kaynak: Donation id
  MEMBER_PAYMENT // kaynak: MemberPayment id (FK yok)
}

// Sayaçlar: bağışçı (yıl 0), bağış (yıl = receivedAt yılı), bildirim (yıl = üretim yılı).
enum DonationsCounterKind {
  DONOR
  DONATION
  CONFIRMATION
}

model DonationsCounter {
  kind    DonationsCounterKind
  year    Int // DONOR için 0
  lastSeq Int                  @default(0)

  @@id([kind, year])
}

// Bağışçı: kişisel veri taşır — ASLA silinmez; anonimleştirme (§ 11 md. 12)
// ad/adres/iletişim alanlarını temizler, numara ve bağış kayıtları kalır.
model Donor {
  id               String    @id @default(cuid())
  donorNumber      Int       @unique // görüntü: SP-0001
  type             DonorType
  firstName        String?
  lastName         String?
  organizationName String?
  street           String?
  postalCode       String?
  city             String?
  country          String?   @default("Deutschland")
  email            String?
  phone            String?
  memberId         String? // ipucu; veri KOPYALANIR, bağlanmaz (FK yok)
  note             String?
  isActive         Boolean   @default(true)
  isAnonymized     Boolean   @default(false)
  anonymizedAt     DateTime?
  createdById      String
  createdByLabel   String
  updatedById      String?
  updatedByLabel   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  donations     Donation[]
  confirmations ZuwendungConfirmation[]

  @@index([lastName, firstName])
  @@index([organizationName])
}

model Donation {
  id                String         @id @default(cuid())
  donationNumber    String         @unique // BG-2026-0001
  year              Int
  sequence          Int
  donorId           String
  donor             Donor          @relation(fields: [donorId], references: [id], onDelete: Restrict)
  receivedAt        DateTime       @db.Date // Tag der Zuwendung
  amount            Decimal        @db.Decimal(12, 2) // her zaman pozitif
  method            DonationMethod
  reference         String? // dekont/eşleştirme referansı (≤ 100)
  purposeNote       String? // bağışın amacı notu (≤ 300)

  // Aufwandsspende (§ 11 md. 4): önceden doğmuş gider karşı talebinden vazgeçme.
  waivedReimbursement Boolean @default(false)
  claimBasis        String? // talep dayanağı (sözleşme, Vorstandsbeschluss…) 5-300
  waiverDeclaredAt  DateTime? @db.Date // vazgeçimin beyan tarihi
  expenseCategoryId String? // gider kategorisi (accounting id, düz)

  bookingNumber       String? // gelir fişi (accounting)
  waiverBookingNumber String? // gider fişi (yalnız vazgeçimli)

  reversedAt       DateTime?
  reversedById     String?
  reversedByLabel  String?
  reverseReason    String?

  createdById    String
  createdByLabel String
  updatedById    String?
  updatedByLabel String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // KARAR: Item ilişki alanı YOK — aktif öge sorgusu ZuwendungConfirmationItem
  // tablosundan sourceId ile yapılır (§ 10: item.sourceId düz string, FK yok).

  @@unique([year, sequence])
  @@index([donorId])
  @@index([receivedAt])
}

// Resmi bildirim: üretim anındaki DEĞİŞMEZ anlık görüntü (recipient + issuer +
// tutar + yazıyla tutar + şablon sürümü). İptal edilse bile PDF bayt aynı kalır.
model ZuwendungConfirmation {
  id                 String               @id @default(cuid())
  confirmationNumber String               @unique // ZB-2026-0001 (asla yeniden kullanılmaz)
  year               Int
  sequence           Int
  kind               ConfirmationKind
  content            ConfirmationContent
  donorId            String?
  donor              Donor?               @relation(fields: [donorId], references: [id], onDelete: Restrict)
  memberId           String? // aidat bildirimleri (üye no ipucu; FK yok)
  recipientName      String // basıldığı haliyle alıcı anlık görüntüsü
  recipientStreet    String
  recipientPostalCode String
  recipientCity      String
  recipientCountry   String?
  periodFrom         DateTime             @db.Date
  periodTo           DateTime             @db.Date
  totalAmount        Decimal              @db.Decimal(12, 2)
  amountInWords      String // amountToGermanWords çıktısı
  waivedReimbursement Boolean
  issuerSnapshot     Json // dernek verileri + muafiyet verileri (§ 11 md. 9)
  templateVersion    String // TEMPLATE_VERSION; uyuşmazsa üretim engellenir
  issuedAt           DateTime             @default(now())
  issuedPlace        String // dernek şehri
  issuedById         String
  issuedByLabel      String
  status             ConfirmationStatus   @default(ISSUED)
  cancelledAt        DateTime?
  cancelledById      String?
  cancelledByLabel   String?
  cancelReason       String?
  replacesId         String? // "Yerine yenisini oluştur" zinciri
  replaces           ZuwendungConfirmation? @relation("Replacement", fields: [replacesId], references: [id], onDelete: Restrict)
  replacedBy         ZuwendungConfirmation[] @relation("Replacement")

  // Depolanmış PDF (§ 11 md. 9): UPLOAD_DIR altında göreli yol + bütünlük.
  pdfStoragePath String?
  pdfSha256      String?
  pdfSize        Int?

  items ZuwendungConfirmationItem[]

  @@unique([year, sequence])
  @@index([donorId])
  @@index([memberId])
  @@index([status])
}

// Bildirim ögesi: ISSUED iken activeKey dolu (bir öge iki aktif bildirimde
// OLAMAZ — @@unique). İptalde activeKey NULL'a çekilir → öge yeniden kullanılabilir.
model ZuwendungConfirmationItem {
  id             String   @id @default(cuid())
  confirmationId String
  confirmation   ZuwendungConfirmation @relation(fields: [confirmationId], references: [id], onDelete: Restrict)
  position       Int
  itemType       ConfirmationItemType
  sourceId       String // Donation id veya MemberPayment id
  itemDate       DateTime @db.Date
  amount         Decimal  @db.Decimal(12, 2)
  label          String // "Geldspende" | "Mitgliedsbeitrag"
  waived         Boolean
  activeKey      String?  @unique // "<itemType>:<sourceId>" — yalnız NULL'a iner

  @@index([confirmationId])
}

// Şablon metin onayı (§ 14): üretim öncesi templateConfirmedVersion ===
// TEMPLATE_VERSION şartı buradan denetlenir.
model DonationsSettings {
  id                       String    @id // her zaman "singleton"
  templateConfirmedVersion String?
  templateConfirmedAt      DateTime?
  templateConfirmedById    String?
  templateConfirmedByLabel String?
  updatedAt                DateTime  @updatedAt
}
