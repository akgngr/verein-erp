// organization modülü (Faz 4, 4.2) — dernek ana verileri (Vereinsstammdaten).
// Tek satırlık yapı (id sabit "singleton"); ilk kayıtta upsert ile oluşur.

// Faz 5 (§ 4): muafiyet belgesi türü — bildirim metni buna göre seçilir.
enum ExemptionDocumentType {
  EXEMPTION_NOTICE // Freistellungsbescheid
  TAX_ASSESSMENT_ANNEX // Anlage zum Körperschaftsteuerbescheid
  SPECIAL_ASSESSMENT_60A // Feststellungsbescheid nach § 60a AO
}

// KARAR: Ekspemisyon (Freistellungsbescheid) tarihi ve dönemi PDF antetinde
// yalnızca tarih doluysa basılır (4.2).

model OrganizationProfile {
  id                    String    @id // her zaman "singleton"
  name                  String // "e.V." dâhil tam yasal ad
  street                String?
  postalCode            String?
  city                  String?
  country               String?   @default("Deutschland")
  email                 String?
  phone                 String?
  website               String?
  registerCourt         String? // Amtsgericht
  registerNumber        String? // örn. "VR 12345"
  taxNumber             String? // Steuernummer
  taxOffice             String? // Finanzamt
  exemptionNoticeDate   DateTime? @db.Date // Freistellungs-/Feststellungsbescheid tarihi
  exemptionNoticePeriod String? // örn. "2022–2024"

  // Faz 5 (§ 4): Gemeinnützigkeit alanları — Zuwendungsbestätigung için.
  // KARAR: membershipFeesDeductible varsayılan false — uygulama § 10b Abs. 1
  // Satz 8 EStG kararını VEREMEZ; ADMIN/BOARD bayrağı açmadan aidat bildirimi
  // düzenlenemez (§ 11 md. 8).
  exemptionDocumentType    ExemptionDocumentType?
  charitablePurposes       String? // "der Volks- und Berufsbildung …" — antet cümlesine girer
  membershipFeesDeductible Boolean @default(false)

  // Logo (kullanıcı isteği): PDF antetinde (shared/pdf/letterhead.tsx) kullanılır.
  // KARAR: Yalnızca PNG/JPG, ≤2 MB; dosya UPLOAD_DIR/organization/ altında uuid
  // adla saklanır (shared/files kalıbı); logoUpdatedAt önizleme cache-bust için.
  logoPath          String?
  logoMime          String?
  logoOriginalName  String?
  logoUpdatedAt     DateTime?

  updatedById           String?
  updatedByLabel        String?
  updatedAt             DateTime  @updatedAt
}
