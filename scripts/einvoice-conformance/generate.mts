/**
 * Writes the e-invoice conformance corpus generated by the real accounting builders:
 *   <out>/xrechnung-ubl/<case>.xml   XRechnung 3.0 UBL (KoSIT + Mustang)
 *   <out>/cii/<case>.xml             EN 16931 CII (Mustang)
 *   <out>/zugferd/<case>.pdf         ZUGFeRD / Factur-X PDF/A-3 with embedded CII (Mustang incl. veraPDF)
 * Usage: NODE_OPTIONS="--conditions=react-server" pnpm exec tsx scripts/einvoice-conformance/generate.ts <out>
 */
import fs from "node:fs";
import path from "node:path";

async function main() {
  const out = path.resolve(process.argv[2] ?? "einvoice-conformance-out");
  const { EINVOICE_FIXTURES } = await import("../../tests/fixtures/einvoice-conformance.ts");
  const { buildXRechnungUbl } = await import("@/modules/accounting/services/einvoice-out");
  const { buildCiiInvoice } = await import("@/modules/accounting/services/einvoice-cii");
  const { toZugferdPdf } = await import("@/modules/accounting/services/zugferd-pdf");
  const { renderZugferdBasePdf } = await import("./render-pdf.mts");

  for (const dir of ["xrechnung-ubl", "cii", "zugferd"]) fs.mkdirSync(path.join(out, dir), { recursive: true });
  for (const [name, data] of Object.entries(EINVOICE_FIXTURES)) {
    fs.writeFileSync(path.join(out, "xrechnung-ubl", `${name}.xml`), buildXRechnungUbl(data));
    const cii = buildCiiInvoice(data);
    fs.writeFileSync(path.join(out, "cii", `${name}.xml`), cii);
    const base = await renderZugferdBasePdf(data);
    const pdf = await toZugferdPdf(base, cii, { title: `Rechnung ${data.number}`, author: data.seller.name, created: new Date(`${data.issueDate}T10:00:00Z`) }); // i18n-ignore (PDF metadata)
    fs.writeFileSync(path.join(out, "zugferd", `${name}.pdf`), pdf);
  }
  console.log(`[einvoice-conformance] ${Object.keys(EINVOICE_FIXTURES).length} cases → ${out}`);
  process.exit(0);
}

main().catch((error) => {
  console.error(error);
  process.exit(1);
});
