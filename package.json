{
  "name": "dernek-yonetim-sistemi",
  "version": "0.32.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=\"--conditions=react-server\" tsx --test \"tests/**/*.test.ts\"",
    "sync:schemas": "tsx scripts/sync-schemas.ts",
    "module:sync": "tsx scripts/sync-schemas.ts",
    "module:create": "tsx scripts/scaffold-module.ts",
    "module:validate": "tsx scripts/validate-module.ts",
    "module:deps": "tsx scripts/module-deps.ts",
    "module:check": "tsx scripts/validate-module.ts",
    "predev": "tsx scripts/sync-schemas.ts && prisma generate",
    "prebuild": "tsx scripts/sync-schemas.ts && prisma generate",
    "pretypecheck": "node -e \"for (const d of ['.next/types', '.next/dev/types']) require('fs').rmSync(d, { recursive: true, force: true })\" && tsx scripts/sync-schemas.ts && prisma generate",
    "db:migrate": "tsx scripts/sync-schemas.ts && prisma migrate dev",
    "db:deploy": "tsx scripts/sync-schemas.ts && prisma migrate deploy && node scripts/verify-db-integrity.mjs",
    "db:verify": "node scripts/verify-db-integrity.mjs",
    "db:baseline": "tsx scripts/sync-schemas.ts && node scripts/db-baseline.mjs",
    "db:push:dev": "tsx scripts/sync-schemas.ts && node scripts/db-push-dev.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@heroui/react": "2.8.10",
    "@heroui/theme": "2.4.26",
    "@hookform/resolvers": "^5.1.1",
    "@internationalized/date": "3.12.4",
    "@mistralai/mistralai": "^3.4.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "docx": "^9.15.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.23.2",
    "imapflow": "^2.10.0",
    "lucide-react": "^0.525.0",
    "mailparser": "^3.14.1",
    "mammoth": "^1.13.0",
    "next": "^16.1.1",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.2.1",
    "openai": "^7.45.1",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.60.0",
    "server-only": "^0.0.1",
    "unpdf": "^2.1.0",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@next/env": "16.4.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/semver": "^7.8.0",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "prisma": "^7.10.1",
    "semver": "^7.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "overrides": {
    "@internationalized/date": "3.12.4"
  },
  "moduleDependencies": {
    "pdf-lib": [
      "accounting"
    ],
    "@anthropic-ai/sdk": [
      "ai"
    ],
    "@mistralai/mistralai": [
      "ai"
    ],
    "openai": [
      "ai"
    ],
    "docx": [
      "exports"
    ],
    "nodemailer": [
      "mail"
    ],
    "imapflow": [
      "mail"
    ],
    "mailparser": [
      "mail"
    ]
  }
}
