    "pg": "^8.23.1",
    "pg-boss": "12.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.60.0",
    "server-only": "^0.0.1",
    "unpdf": "^2.1.0",
    "zod": "^4.0.2",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@next/env": "16.4.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/semver": "^7.8.0",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "prisma": "^7.10.1",
    "semver": "^7.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "overrides": {
    "@internationalized/date": "3.12.4"
  },
