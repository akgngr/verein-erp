{
  "name": "dernek-yonetim-sistemi",
  "version": "0.40.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=\"--conditions=react-server\" tsx --test \"tests/**/*.test.ts\"",
    "test:accounting": "NODE_OPTIONS=\"--conditions=react-server\" tsx --test \"tests/accounting/*.test.ts\"",
    "test:ai": "NODE_OPTIONS=\"--conditions=react-server\" tsx --test \"tests/ai/*.test.ts\"",
    "test:automation": "NODE_OPTIONS=\"--conditions=react-server\" tsx --test \"tests/automation/*.test.ts\"",
    "test:banking": "NODE_OPTIONS=\"--conditions=react-server\" tsx --test \"tests/banking/*.test.ts\"",
    "test:courses": "NODE_OPTIONS=\"--conditions=react-server\" tsx --test \"tests/courses/*.test.ts\"",
    "test:demo": "NODE_OPTIONS=\"--conditions=react-server\" tsx --test \"tests/demo/*.test.ts\"",
    "test:donations": "NODE_OPTIONS=\"--conditions=react-server\" tsx --test \"tests/donations/*.test.ts\"",
    "test:mail": "NODE_OPTIONS=\"--conditions=react-server\" tsx --test \"tests/mail/*.test.ts\"",
    "test:mailings": "NODE_OPTIONS=\"--conditions=react-server\" tsx --test \"tests/mailings/*.test.ts\"",
    "test:members": "NODE_OPTIONS=\"--conditions=react-server\" tsx --test \"tests/members/*.test.ts\"",
    "test:modules": "NODE_OPTIONS=\"--conditions=react-server\" tsx --test \"tests/modules/*.test.ts\"",
    "test:security": "NODE_OPTIONS=\"--conditions=react-server\" tsx --test \"tests/security/*.test.ts\"",
    "test:shared": "NODE_OPTIONS=\"--conditions=react-server\" tsx --test \"tests/shared/*.test.ts\"",
    "test:all": "pnpm test:accounting && pnpm test:ai && pnpm test:automation && pnpm test:banking && pnpm test:courses && pnpm test:demo && pnpm test:donations && pnpm test:mail && pnpm test:mailings && pnpm test:members && pnpm test:modules && pnpm test:security && pnpm test:shared",
    "sync:schemas": "tsx scripts/sync-schemas.ts",
    "module:sync": "tsx scripts/sync-schemas.ts",
    "module:create": "tsx scripts/scaffold-module.ts",
    "module:validate": "tsx scripts/validate-module.ts",
    "module:deps": "tsx scripts/module-deps.ts",
    "module:check": "tsx scripts/validate-module.ts",
    "predev": "tsx scripts/sync-schemas.ts && prisma generate",
    "prebuild": "tsx scripts/sync-schemas.ts && prisma generate",
    "pretypecheck": "node -e \"for (const d of ['.next/types', '.next/dev/types']) require('fs').rmSync(d, { recursive: true, force: true })\" && tsx scripts/sync-schemas.ts && prisma generate",
    "db:migrate": "tsx scripts/sync-schemas.ts && prisma migrate dev",
    "db:deploy": "tsx scripts/sync-schemas.ts && prisma migrate deploy && node scripts/verify-db-integrity.mjs",
    "db:verify": "node scripts/verify-db-integrity.mjs",
    "db:baseline": "tsx scripts/sync-schemas.ts && node scripts/db-baseline.mjs",
    "db:push:dev": "tsx scripts/sync-schemas.ts && node scripts/db-push-dev.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "module:keygen": "tsx scripts/module-keygen.ts",
    "module:pack": "tsx scripts/module-pack.ts",
    "module:install": "tsx scripts/module-install.ts",
    "dev:web": "next dev -p 3000",
    "dev:full": "tsx scripts/dev-full.ts",
    "automation:worker": "NODE_OPTIONS=--conditions=react-server tsx src/modules/automation/worker/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@heroui/react": "2.8.10",
    "@heroui/theme": "2.4.26",
    "@hookform/resolvers": "^5.1.1",
    "@internationalized/date": "3.12.4",
    "@mistralai/mistralai": "^3.4.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-email/editor": "^1.7.18",
    "@react-pdf/renderer": "^4.9.0",
    "@workflowbuilder/sdk": "3.0.0",
    "@xyflow/react": "12.10.2",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "docx": "^9.15.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.23.2",
    "imapflow": "^2.10.0",
    "lucide-react": "^0.525.0",
    "mailparser": "^3.14.1",
    "mammoth": "^1.13.0",
    "next": "^16.1.1",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.2.1",
