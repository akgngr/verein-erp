enum MailingStatus {
  DRAFT
  SCHEDULED
  SENDING
  DONE
  FAILED
  CANCELLED
}

/// Toplu e-posta gönderimi. Alıcı başına sonuç mail_logs'ta (module=mailings, reference=id).
/// KVKK: alıcı listesi saklanmaz; yalnızca kaynak, filtre ve sayılar.
model MailingCampaign {
  id             String        @id @default(cuid())
  /// Kampanya adı (panoda görünür). Eski kayıtlarda boş: konu gösterilir.
  name           String        @default("")
  /// Gönderim kanalı (channels.ts eklentisi): "email", ileride "sms" | "telegram" | "whatsapp".
  channel        String        @default("email")
  /// Kampanya bir iş akışı olarak çalışır (automation_workflows.id). Programatik gönderimlerde boş.
  workflowId     String?
  /// Planlı gönderim zamanı (iş akışındaki bekleme adımı).
  scheduledAt    DateTime?
  /// E-posta açılma/tıklama izleme (kampanya başına; varsayılan açık).
  tracking       Boolean       @default(true)
  /// İzleme bağlantılarının kökü (kampanyayı başlatan isteğin genel adresi; worker bunu kullanır).
  trackingBaseUrl String?
  /// "<modül>:<kaynak>" (ör. members:members) veya programatik çağrıda "<modül>:api"
  source         String
  filter         Json          @default("{}")
  subject        String
  body           String
  /// Editörden gelen e-posta HTML'i (yer tutuculu); düz metin sürümü `body`.
  bodyHtml       String?
  /// Blok tabanlı e-posta tasarımı (editörde yeniden açmak için); gönderim bodyHtml ile yapılır.
  design         Json?
  status         MailingStatus @default(SENDING)
  recipientCount Int           @default(0)
  sentCount      Int           @default(0)
  failedCount    Int           @default(0)
  skippedNoEmail Int           @default(0)
  skippedOptOut  Int           @default(0)
  createdById    String
  createdByLabel String
  createdAt      DateTime      @default(now())
  finishedAt     DateTime?

  @@index([createdAt])
  @@index([status])
  @@map("mailings_campaigns")
}

/// Kayıtlı segment: bir alıcı kaynağı için adlandırılmış filtre. Kişi listesi DEĞİL; her gönderimde güncel
/// veriden yeniden hesaplanır.
model MailingSegment {
  id             String   @id @default(cuid())
  name           String
  /// "<modül>:<kaynak>"
  source         String
  filter         Json     @default("{}")
  createdById    String
  createdByLabel String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([source, name])
  @@map("mailings_segments")
}

/// Kampanya kanalı ayarları (SMS/Telegram/WhatsApp eklentileri). Gizli değerler secret-box ile şifreli.
model MailingChannelConfig {
  channel     String   @id
  settings    Json     @default("{}")
  secretsEnc  String?
  updatedById String
  updatedAt   DateTime @updatedAt

  @@map("mailings_channel_configs")
}

/// Alıcı başına gönderim kaydı (tüm kanallar): durum, teslim, açılma/okunma, tıklama. Yeniden denemede
/// çift gönderimi de önler. KVKK: adres ve zaman damgaları; içerik saklanmaz.
model MailingDelivery {
  id           String    @id @default(cuid())
  campaignId   String
  channel      String
  address      String
  /// İzleme bağlantılarındaki rastgele belirteç (tahmin edilemez).
  token        String    @unique
  /// QUEUED → SENT → DELIVERED → READ; ya da FAILED.
  status       String    @default("QUEUED")
  providerId   String?
  error        String?
  sentAt       DateTime?
  deliveredAt  DateTime?
  /// E-postada açılma (piksel), WhatsApp'ta okundu bildirimi.
  readAt       DateTime?
  openCount    Int       @default(0)
  firstClickAt DateTime?
  clickCount   Int       @default(0)
  createdAt    DateTime  @default(now())

  @@unique([campaignId, address])
  @@index([providerId])
  @@index([createdAt])
  @@map("mailings_deliveries")
}
