enum MailingStatus {
  DRAFT
  SCHEDULED
  SENDING
  DONE
  FAILED
  CANCELLED
}

/// Toplu e-posta gönderimi. Alıcı başına sonuç mail_logs'ta (module=mailings, reference=id).
/// KVKK: alıcı listesi saklanmaz; yalnızca kaynak, filtre ve sayılar.
model MailingCampaign {
  id             String        @id @default(cuid())
  /// Kampanya adı (panoda görünür). Eski kayıtlarda boş: konu gösterilir.
  name           String        @default("")
  /// Gönderim kanalı (channels.ts eklentisi): "email", ileride "sms" | "telegram" | "whatsapp".
  channel        String        @default("email")
  /// Kampanya bir iş akışı olarak çalışır (automation_workflows.id). Programatik gönderimlerde boş.
  workflowId     String?
  /// Planlı gönderim zamanı (iş akışındaki bekleme adımı).
  scheduledAt    DateTime?
  /// "<modül>:<kaynak>" (ör. members:members) veya programatik çağrıda "<modül>:api"
  source         String
  filter         Json          @default("{}")
  subject        String
  body           String
  /// Editörden gelen e-posta HTML'i (yer tutuculu); düz metin sürümü `body`.
  bodyHtml       String?
  status         MailingStatus @default(SENDING)
  recipientCount Int           @default(0)
  sentCount      Int           @default(0)
  failedCount    Int           @default(0)
  skippedNoEmail Int           @default(0)
  skippedOptOut  Int           @default(0)
  createdById    String
  createdByLabel String
  createdAt      DateTime      @default(now())
  finishedAt     DateTime?

  @@index([createdAt])
  @@index([status])
  @@map("mailings_campaigns")
}

/// Kayıtlı segment: bir alıcı kaynağı için adlandırılmış filtre. Kişi listesi DEĞİL; her gönderimde güncel
/// veriden yeniden hesaplanır.
model MailingSegment {
  id             String   @id @default(cuid())
  name           String
  /// "<modül>:<kaynak>"
  source         String
  filter         Json     @default("{}")
  createdById    String
  createdByLabel String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([source, name])
  @@map("mailings_segments")
}

/// Kampanya kanalı ayarları (SMS/Telegram/WhatsApp eklentileri). Gizli değerler secret-box ile şifreli.
model MailingChannelConfig {
  channel     String   @id
  settings    Json     @default("{}")
  secretsEnc  String?
  updatedById String
  updatedAt   DateTime @updatedAt

  @@map("mailings_channel_configs")
}

/// E-posta dışı kanallarda başarılı gönderim kaydı (yeniden denemede çift gönderimi önler).
model MailingDelivery {
  id         String   @id @default(cuid())
  campaignId String
  channel    String
  address    String
  providerId String?
  createdAt  DateTime @default(now())

  @@unique([campaignId, address])
  @@index([createdAt])
  @@map("mailings_deliveries")
}
