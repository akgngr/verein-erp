/// Kullanıcının AI asistanı için verdiği açık rıza (KVKK/DSGVO). Kayıt yoksa asistan kullanılamaz.
/// Rıza belirli bir sağlayıcıya verilir; yönetici sağlayıcıyı değiştirirse rıza yeniden istenir.
/// Sohbet içeriği SAKLANMAZ; yalnızca rızanın kendisi, sürümü ve sağlayıcısı tutulur.
model AiUserConsent {
  userId     String   @id // FK DEĞİL (yumuşak referans)
  version    Int
  provider   String   @default("")
  acceptedAt DateTime @default(now())

  @@map("ai_user_consents")
}

/// Asistan ayarı (tekil kayıt "singleton"): seçili sağlayıcı ve modül bazında izin matrisi
/// ({ "<modül>": ["read","create","update","delete"] }). KARAR: varsayılan BOŞ — yönetici
/// işaretlemeden asistan hiçbir veriye erişmez ve hiçbir işlem öneremez.
model AiSettings {
  id          String   @id
  provider    String
  permissions Json     @default("{}")
  updatedAt   DateTime @updatedAt

  @@map("ai_settings")
}

/// Sağlayıcı bağlantı bilgisi. API anahtarı AES-256-GCM ile ŞİFRELİ saklanır, istemciye asla dönmez.
model AiProviderCredential {
  provider  String   @id // local | mistral | anthropic | openai
  apiKeyEnc String?
  model     String?
  baseUrl   String?
  updatedAt DateTime @updatedAt

  @@map("ai_provider_credentials")
}

/// Sohbet geçmişi (kullanıcıya özel). KARAR (KVKK/DSGVO): başlık ve mesaj içerikleri AES-256-GCM
/// ile ŞİFRELİ saklanır; yalnızca sahibi okuyabilir ve silebilir. AI_CONVERSATION_RETENTION_DAYS
/// günden eski sohbetler otomatik silinir. Silinen kullanıcının sohbetleri de silinir.
model AiConversation {
  id        String      @id @default(cuid())
  userId    String // FK DEĞİL (yumuşak referans)
  titleEnc  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String // user | assistant
  contentEnc     String
  proposalsEnc   String?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}
