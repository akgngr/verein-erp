/// Kullanıcının AI asistanı için verdiği açık rıza (KVKK/DSGVO). Kayıt yoksa asistan kullanılamaz.
/// Rıza belirli bir sağlayıcıya verilir; yönetici sağlayıcıyı değiştirirse rıza yeniden istenir.
/// Sohbet içeriği SAKLANMAZ; yalnızca rızanın kendisi, sürümü ve sağlayıcısı tutulur.
model AiUserConsent {
  userId     String   @id // FK DEĞİL (yumuşak referans)
  version    Int
  provider   String   @default("")
  acceptedAt DateTime @default(now())

  @@map("ai_user_consents")
}

/// Asistan ayarı (tekil kayıt "singleton"): seçili sağlayıcı ve asistana açılan alanlar.
/// KARAR: enabledAreas varsayılan BOŞ — yönetici tek tek işaretlemeden asistan hiçbir veriye erişmez.
model AiSettings {
  id           String   @id
  provider     String
  enabledAreas String[] @default([])
  updatedAt    DateTime @updatedAt

  @@map("ai_settings")
}

/// Sağlayıcı bağlantı bilgisi. API anahtarı AES-256-GCM ile ŞİFRELİ saklanır, istemciye asla dönmez.
model AiProviderCredential {
  provider  String   @id // local | mistral | anthropic | openai
  apiKeyEnc String?
  model     String?
  baseUrl   String?
  updatedAt DateTime @updatedAt

  @@map("ai_provider_credentials")
}
