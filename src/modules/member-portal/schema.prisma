model PortalLoginToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  subjectRef String
  nonceHash  String
  purpose    String    @default("login") // "login" | "stepup"
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([subjectRef, expiresAt])
  @@map("portal_login_tokens")
}

model PortalSession {
  id          String    @id @default(cuid())
  sessionHash String    @unique
  subjectRef  String
  stepUpUntil DateTime?
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([subjectRef, expiresAt])
  @@map("portal_sessions")
}

model PortalPasskey {
  id           String   @id @default(cuid())
  subjectRef   String
  credentialId String   @unique
  publicKey    String
  counter      Int      @default(0)
  transports   String?
  createdAt    DateTime @default(now())

  @@index([subjectRef])
  @@map("portal_passkeys")
}

model SecurityRateLimit {
  key         String    @id
  count       Int       @default(0)
  windowStart DateTime
  lockedUntil DateTime?

  @@map("security_rate_limits")
}

model PortalConsentChallenge {
  id            String    @id @default(cuid())
  subjectRef    String
  channel       String
  addressMasked String
  tokenHash     String    @unique
  expiresAt     DateTime
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([subjectRef, channel])
  @@map("portal_consent_challenges")
}

model PortalArt15Request {
  id              String   @id @default(cuid())
  subjectRef      String
  memberId        String
  status          String   @default("PENDING") // "PENDING" | "READY"
  generatedFileId String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([subjectRef, status])
  @@index([memberId, createdAt])
  @@map("portal_art15_requests")
}
