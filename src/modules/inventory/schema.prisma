model InventoryItem {
  id               String    @id @default(uuid())
  name             String
  category         String    @default("OTHER")
  serialNumber     String?
  location         String?
  quantity         Int       @default(1)
  status           String    @default("IDLE")
  purchaseDate     DateTime? @db.Date
  purchasePrice    Decimal?  @db.Decimal(12, 2)
  description      String?
  assignedMemberId String?
  /// Muhasebede demirbaş (AfA) olarak izlenir; muhasebe modülü etkinse senkron tutulur.
  trackAsAsset     Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  /// #582: Yumuşak silme; kayıt denetim ve AfA izlenebilirliği için korunur, listelerden kalkar.
  deletedAt        DateTime?
  deletedById      String?

  @@index([category])
  @@index([status])
  @@index([assignedMemberId])
  @@index([deletedAt])
  @@map("inventory_items")
}
