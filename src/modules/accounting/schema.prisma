// Muhasebe modülü (Faz 4, PART B): nakit esaslı basit defter tutma
// (Einnahmen-Überschuss-Rechnung, EÜR). Gemeinnütziger Verein için dört
// faaliyet alanı (Tätigkeitsbereiche); her kategori tam olarak bir alana aittir.
//
// KARAR: Muhasebe yılı takvim yılıdır (§ 5). Tüm tutarlar Decimal(12,2) kolonlarda
// saklanır; TypeScript tarafında aritmetik integer cent üzerinden yapılır
// (shared/money.ts). Kayıtlar ASLA silinmez — yalnızca ters kayıtla (Storno)
// düzeltilir; DB tetikleyicileri bunu zorunlu kılar (migration SQL).

enum AccountType {
  CASH // Kasa (Kasse)
  BANK // Banka hesabı (Girokonto)
  OTHER // Diğer (Sonstiges)
}

enum BookingType {
  INCOME // Gelir (Einnahme)
  EXPENSE // Gider (Ausgabe)
  TRANSFER // Virman (Umbuchung)
}

enum CategoryDirection {
  INCOME // Gelir
  EXPENSE // Gider
}

// Faaliyet alanları (§ 5):
enum Sphere {
  IDEELL // ideel alan (aidat, bağış, olağan giderler)
  ASSET_MANAGEMENT // varlık yönetimi (faiz, kira)
  PURPOSE_OPERATION // amaca bağlı işletme (Zweckbetrieb)
  ECONOMIC_OPERATION // vergiye tabi ticari işletme (wirtschaftlicher Geschäftsbetrieb)
}

// Fiş numarası sayacı: yıl bazında sıra; üretim atomik upsert ile yapılır.
model AccountingCounter {
  year    Int
  lastSeq Int @default(0)

  @@id([year])
}

model AccountingAccount {
  id             String      @id @default(cuid())
  name           String      @unique // örn. "Kasa (Kasse)", "Banka hesabı (Girokonto)"
  type           AccountType
  openingBalance Decimal     @default(0) @db.Decimal(12, 2)
  openingDate    DateTime    @db.Date
  /// SKR03/SKR04 finans hesabı (ör. SKR03 Kasse 1000, Bank 1200) — DATEV dışa aktarma için.
  accountNumber  String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  bookings       AccountingBooking[] @relation("BookingAccount")
  transfersIn    AccountingBooking[] @relation("BookingCounterAccount")
}

model AccountingCategory {
  id         String            @id @default(cuid())
  name       String            @unique
  direction  CategoryDirection
  sphere     Sphere
  helpText   String? // örn. Ehrenamtspauschale yardım metni
  /// SKR03/SKR04 gelir/gider hesabı (ör. SKR03 8400 Erlöse 19 %) — DATEV dışa aktarma için.
  accountNumber  String?
  /// Bu kategoride yeni fişin varsayılan KDV oranı (yüzde: 0, 7, 19).
  defaultTaxRate Int           @default(0)
  sortOrder  Int               @default(0)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  bookings   AccountingBooking[]
  budgetLines AccountingBudgetLine[]
}

model AccountingProject {
  id        String   @id @default(cuid())
  name      String   @unique
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bookings  AccountingBooking[]
}

model AccountingBooking {
  id              String      @id @default(cuid())
  year            Int // bookingDate yılı
  sequence        Int
  bookingNumber   String      @unique // B-2026-0001
  type            BookingType
  bookingDate     DateTime    @db.Date
  accountId       String
  account         AccountingAccount   @relation("BookingAccount", fields: [accountId], references: [id], onDelete: Restrict)
  counterAccountId String? // TRANSFER hedef hesabı
  counterAccount  AccountingAccount?  @relation("BookingCounterAccount", fields: [counterAccountId], references: [id], onDelete: Restrict)
  categoryId      String? // TRANSFER'de null
  category        AccountingCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  projectId       String?
  project         AccountingProject?  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  amount          Decimal     @db.Decimal(12, 2) // BRÜT, her zaman pozitif (bakiye ve raporlar brüt)
  /// KDV (ACC-1): gelirde Umsatzsteuer, giderde Vorsteuer. amount = netAmount + taxAmount.
  taxRate         Int         @default(0) // yüzde: 0, 7, 19
  netAmount       Decimal     @db.Decimal(12, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(12, 2)
  description     String // Buchungstext
  counterparty    String? // ödeyen/alacaklı (serbest metin)
  receiptReference String? // harici belge/fatura numarası

  // Kaynak bağlantısı (KARAR: FK YOK — modüller arası bağımsızlık):
  // "MEMBER_PAYMENT" (üyelik aktarımı) veya null (elle fiş).
  sourceType      String?
  sourceId        String?

  reversedAt      DateTime?
  reversedById    String?
  reversedByLabel String?
  reverseReason   String?

  createdById     String
  createdByLabel  String
  updatedById     String?
  updatedByLabel  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  files           AccountingBookingFile[]

  @@unique([year, sequence])
  @@unique([sourceType, sourceId])
  @@index([bookingDate])
  @@index([accountId])
  @@index([categoryId])
  @@index([projectId])
  @@index([year, type])
}

model AccountingBookingFile {
  id              String    @id @default(cuid())
  bookingId       String
  booking         AccountingBooking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  originalName    String
  storedName      String    @unique
  storagePath     String               // accounting/<year>/<bookingId>/<storedName>
  mimeType        String
  size            Int
  uploadedById    String
  uploadedByLabel String
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?
  deletedById     String?
  deletedByLabel  String?

  @@index([bookingId])
}

model AccountingYear {
  year           Int       @id
  lockedAt       DateTime?
  lockedById     String?
  lockedByLabel  String?
}

model AccountingBudgetLine {
  id         String   @id @default(cuid())
  year       Int
  categoryId String
  category   AccountingCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount     Decimal  @db.Decimal(12, 2)
  updatedAt  DateTime @updatedAt

  @@unique([year, categoryId])
}

model AccountingSettings {
  id                  String  @id // her zaman "singleton"
  memberFeeCategoryId String?
  cashAccountId       String? // CASH yöntemli ödemelerin hesabı
  bankAccountId       String? // BANK_TRANSFER/CARD/OTHER hesabı
  // Faz 5 (§ 6): bağış gelir kategorisi (aktif INCOME kategorisi olmalı).
  donationCategoryId  String?
  // ACC-1 vergi temeli:
  /// Hesap planı: "SKR03" | "SKR04" (DATEV dışa aktarma, hesap önerileri).
  chartOfAccounts     String  @default("SKR03")
  /// § 19 UStG küçük işletme: KDV hesaplanmaz, indirilemez (tüm fişlerde oran 0).
  smallBusiness       Boolean @default(false)
  /// Vergilendirme: "IST" (tahsilat esası) | "SOLL" (tahakkuk esası) — UStVA hesaplaması için.
  taxMethod           String  @default("IST")
  /// UStVA dönemi: "MONTH" | "QUARTER" | "YEAR".
  vatPeriod           String  @default("QUARTER")
  /// ACC-2: DATEV EXTF başlığı (Beraternummer 4–7, Mandantennummer 1–5 hane) ve BU-Schlüssel kullanımı.
  datevConsultantNo   String  @default("")
  datevClientNo       String  @default("")
  datevTaxKeys        Boolean @default(false)
  updatedAt           DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Faturalar (Rechnung) ve proforma faturalar.
// KARAR (GoBD/§ 14 UStG): numara yalnızca kesinleşince (ISSUED) verilir; taslak numarasızdır,
// numaralar yıl ve türe göre boşluksuz artar. Kesinleşen fatura değiştirilemez, yalnızca iptal edilir.
// ---------------------------------------------------------------------------

enum InvoiceKind {
  INVOICE // Rechnung: R-2026-0001
  PROFORMA // Proforma-Rechnung: PF-2026-0001
  QUOTE // Angebot: AN-2026-0001 (ACC-3)
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

model AccountingInvoiceCounter {
  kind    InvoiceKind
  year    Int
  lastSeq Int         @default(0)

  @@id([kind, year])
}

model AccountingInvoice {
  id               String        @id @default(cuid())
  kind             InvoiceKind
  status           InvoiceStatus @default(DRAFT)
  number           String?       @unique
  year             Int?
  sequence         Int?
  issueDate        DateTime      @db.Date
  dueDate          DateTime?     @db.Date
  serviceDate      String? // Leistungsdatum/-zeitraum (serbest metin, ör. "März 2026")
  recipientName    String
  recipientAddress String? // çok satırlı adres
  recipientEmail   String?
  subject          String?
  introText        String?
  footerText       String?
  taxNote          String? // ör. § 19 UStG / steuerbefreit
  netCents         Int           @default(0)
  taxCents         Int           @default(0)
  grossCents       Int           @default(0)
  // Ödeme alınınca oluşturulan gelir fişi (aynı modül): sourceType "INVOICE".
  categoryId       String?
  bookingId        String?
  // Proformadan dönüştürülen faturada kaynak proforma.
  sourceProformaId String?
  /// ACC-3: cari kart (isteğe bağlı; alıcı alanları anlık görüntü olarak kalır).
  contactId        String?
  contact          AccountingContact? @relation(fields: [contactId], references: [id], onDelete: Restrict)
  /// ACC-3: tahsil edilen ve Skonto/silinen tutar (cent); açık = grossCents − paidCents − skontoCents.
  paidCents        Int           @default(0)
  skontoCents      Int           @default(0)
  issuedAt         DateTime?
  paidAt           DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdById      String
  createdByLabel   String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  lines    AccountingInvoiceLine[]
  payments AccountingInvoicePayment[]

  @@unique([kind, year, sequence])
  @@index([status])
  @@index([issueDate])
}

model AccountingInvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  position       Int
  description    String
  quantity       Decimal @db.Decimal(10, 2)
  unit           String?
  unitPriceCents Int
  taxRate        Int // yüzde (0, 7, 19)
  totalCents     Int // net satır toplamı

  invoice AccountingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// Fatura varsayılanları (tekil kayıt "singleton").
model AccountingInvoiceSettings {
  id                String  @id // her zaman "singleton"
  defaultTaxRate    Int     @default(0)
  taxNote           String? // ör. "Gemäß § 19 UStG wird keine Umsatzsteuer berechnet."
  paymentDays       Int     @default(14)
  bankDetails       String? // IBAN / BIC / Bank
  footerText        String?
  incomeCategoryId  String? // ödeme fişi için varsayılan gelir kategorisi
  updatedAt         DateTime @updatedAt
}

enum ContactType {
  CUSTOMER // Debitor (10000–69999)
  SUPPLIER // Kreditor (70000–99999)
}

/// ACC-3: cari kart (müşteri/tedarikçi). Kişisel veri içerir — yalnızca muhasebe izinleriyle görülür.
model AccountingContact {
  id              String      @id @default(cuid())
  type            ContactType
  number          Int         @unique // DATEV Personenkonto
  name            String
  contactPerson   String?
  address         String? // çok satırlı
  email           String?
  phone           String?
  vatId           String? // USt-IdNr.
  paymentTermDays Int?
  notes           String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  invoices AccountingInvoice[]

  @@index([type, name])
}

/// ACC-3: fatura tahsilatı (kısmi ödeme + isteğe bağlı Skonto/kalan kapatma).
model AccountingInvoicePayment {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        AccountingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  paidDate       DateTime @db.Date
  amountCents    Int
  skontoCents    Int      @default(0)
  accountId      String
  bookingNumbers String // virgülle ayrılmış fiş numaraları (gösterim)
  createdById    String
  createdByLabel String
  createdAt      DateTime @default(now())

  @@index([invoiceId])
}

enum BankTransactionStatus {
  OPEN // öneri bekliyor
  BOOKED // fişe / fatura tahsilatına bağlandı
  PRIVATE // özel (Privatentnahme/-einlage) — EÜR dışı, fiş yok
  IGNORED // kullanıcı yok saydı (ör. mükerrer, iç virman başka yerde)
}

enum BankRuleField {
  COUNTERPARTY
  PURPOSE
}

/// ACC-4: banka ekstresi içe aktarımı (dosya içeriği SAKLANMAZ; yalnızca satırlar).
model AccountingBankImport {
  id             String   @id @default(cuid())
  accountId      String
  format         String // CAMT053 | MT940 | CSV
  fileName       String
  totalCount     Int
  newCount       Int
  createdById    String
  createdByLabel String
  createdAt      DateTime @default(now())

  transactions AccountingBankTransaction[]
}

/// ACC-4: ekstre satırı. hash = hesap + tarih + tutar + IBAN + referans + açıklama → mükerrer engeli.
model AccountingBankTransaction {
  id               String                @id @default(cuid())
  importId         String
  import           AccountingBankImport  @relation(fields: [importId], references: [id], onDelete: Cascade)
  accountId        String
  hash             String                @unique
  bookingDate      DateTime              @db.Date
  valueDate        DateTime?             @db.Date
  amountCents      Int // işaretli: + gelen, − giden
  currency         String                @default("EUR")
  counterpartyName String?
  counterpartyIban String?
  purpose          String
  reference        String?
  status           BankTransactionStatus @default(OPEN)
  bookingIds       String? // virgülle ayrılmış fiş id'leri
  invoiceId        String?
  note             String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([accountId, status, bookingDate])
}

/// ACC-4: öğrenilmiş eşleştirme kuralı ("karşı taraf/açıklama içerir → kategori + KDV").
model AccountingBankRule {
  id         String        @id @default(cuid())
  field      BankRuleField
  pattern    String
  direction  BookingType
  categoryId String
  taxRate    Int           @default(0)
  hits       Int           @default(0)
  createdAt  DateTime      @default(now())

  @@unique([field, pattern, direction])
}
