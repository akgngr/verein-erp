enum CalendarKind {
  PERSONAL
  SHARED
}

enum CalendarRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

/// Takvim: kişisel (yalnız sahibi görür) veya ortak (takvim yetkisi olan herkes görür).
model Calendar {
  id          String          @id @default(cuid())
  kind        CalendarKind    @default(PERSONAL)
  name        String
  color       String          @default("#3b82f6")
  ownerId     String? // PERSONAL: kullanıcı kimliği (FK değil: modüller arası bağımsızlık)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  entries     CalendarEntry[]

  @@index([kind, ownerId])
  @@map("calendar_calendars")
}

/// Randevu / hatırlatma. Tekrarlayan kayıtlar görüntülenirken aralığa göre açılır.
model CalendarEntry {
  id                 String             @id @default(cuid())
  calendarId         String
  calendar           Calendar           @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  location           String?
  startsAt           DateTime
  endsAt             DateTime
  allDay             Boolean            @default(false)
  recurrence         CalendarRecurrence @default(NONE)
  recurrenceInterval Int                @default(1)
  recurrenceUntil    DateTime?
  /// Etkinliğe dönüştürüldüyse events modülündeki kayıt (FK değil).
  eventId            String?
  createdById        String
  createdByLabel     String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([calendarId, startsAt])
  @@index([startsAt, endsAt])
  @@map("calendar_entries")
}

/// Kişisel ICS abonelik anahtarı. Yalnız SHA-256 özeti saklanır; düz anahtar bir kez gösterilir.
model CalendarFeedToken {
  id         String    @id @default(cuid())
  userId     String    @unique
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@map("calendar_feed_tokens")
}

enum CalendarSyncStatus {
  PENDING
  ACTIVE
  ERROR
  REAUTH
}

/// OAuth application per sync provider (admin). Client secret sealed (secret-box).
model CalendarSyncApp {
  provider        String   @id
  clientId        String
  clientSecretEnc String
  tenant          String?
  updatedById     String
  updatedAt       DateTime @updatedAt

  @@map("calendar_sync_apps")
}

/// A user's connected external calendar account. Credentials sealed; never sent to the client.
model CalendarSyncAccount {
  id             String             @id @default(cuid())
  provider       String
  userId         String
  accountLabel   String             @default("")
  credentialsEnc String?
  /// SHA-256 of the one-time OAuth state while status = PENDING.
  stateHash      String?            @unique
  status         CalendarSyncStatus @default(PENDING)
  lastSyncAt     DateTime?
  lastError      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  calendars      CalendarSyncCalendar[]

  @@unique([provider, userId])
  @@map("calendar_sync_accounts")
}

/// Remote calendar of a connected account; only enabled ones are imported.
model CalendarSyncCalendar {
  id        String              @id @default(cuid())
  accountId String
  account   CalendarSyncAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  remoteId  String
  name      String
  color     String              @default("#64748b")
  enabled   Boolean             @default(true)
  events    CalendarSyncEvent[]

  @@unique([accountId, remoteId])
  @@map("calendar_sync_calendars")
}

/// Imported, read-only occurrence (window: now-60d … now+365d, replaced on each sync).
model CalendarSyncEvent {
  id          String               @id @default(cuid())
  calendarId  String
  calendar    CalendarSyncCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  remoteId    String
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean              @default(false)

  @@unique([calendarId, remoteId])
  @@index([calendarId, startsAt])
  @@map("calendar_sync_events")
}
