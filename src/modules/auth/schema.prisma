/// Kullanıcının kendi doldurduğu profil: iletişim, adres, ödeme (IBAN) ve fatura bilgileri.
/// Örn. öğretmenlere ödeme yapmak ve onların derneğe kestiği faturaları işlemek için.
/// KARAR (KVKK/DSGVO): IBAN ve vergi numarası AES-256-GCM ile ŞİFRELİ saklanır; ekranda
/// maskeli gösterilir. Kayıt yoksa profil boştur.
model UserProfile {
  userId          String   @id // FK DEĞİL (yumuşak referans)
  phone           String?
  mobile          String?
  street          String?
  houseNumber     String?
  postalCode      String?
  city            String?
  country         String?
  accountHolder   String?
  ibanEnc         String?
  bic             String?
  bankName        String?
  businessName    String? // fatura üzerindeki ad / firma (boşsa kişinin adı)
  taxNumberEnc    String?
  vatId           String? // USt-IdNr.
  isSmallBusiness Boolean  @default(false) // § 19 UStG Kleinunternehmer
  updatedAt       DateTime @updatedAt

  @@map("user_profiles")
}

/// #603: Optional TOTP second factor (RFC 6238). `secretEnc` is sealed with the secret box (AES-256-GCM).
/// `enabledAt` null = enrolment started but not confirmed yet (not required at login). `lastUsedStep` is the
/// last accepted time step: a code is accepted once, and never an older one after it (replay protection).
model UserTotp {
  userId       String    @id // FK DEĞİL (yumuşak referans)
  secretEnc    String
  enabledAt    DateTime?
  lastUsedStep Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("user_totp")
}

/// #603: One-time recovery codes for the TOTP second factor (SHA-256 hashes only; the plain codes are shown once).
model UserTotpRecoveryCode {
  id        String    @id @default(cuid())
  userId    String // FK DEĞİL (yumuşak referans)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, codeHash])
  @@index([userId])
  @@map("user_totp_recovery_codes")
}

/// #612: Explicit link between an external sign-in provider subject and an internal ERP user.
/// Sign-in through a provider succeeds ONLY when (provider, subject) is linked here, never by e-mail matching
/// and never by creating a user (no auto-provisioning). Links are created by an authenticated, authorized flow
/// (e.g. the social-login module, #613). No provider tokens are stored.
model AuthIdentity {
  id          String    @id @default(cuid())
  provider    String // AuthProviderDefinition.id
  subject     String // provider's stable account id (OIDC `sub`), never the e-mail
  userId      String // FK DEĞİL (yumuşak referans)
  linkedById  String? // who created the link (the user themselves or an admin)
  linkedAt    DateTime  @default(now())
  lastUsedAt  DateTime?

  @@unique([provider, subject])
  @@index([userId])
  @@map("auth_identities")
}

/// Short-lived, single-use OAuth linking intent. No provider token or password is stored.
model AuthOAuthLinkIntent {
  tokenHash      String   @id
  userId         String
  sessionVersion String
  provider       String
  returnPath     String
  expiresAt      DateTime

  @@unique([userId])
  @@index([expiresAt])
  @@map("auth_oauth_link_intents")
}
