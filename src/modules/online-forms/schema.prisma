enum OnlineFormKind {
  MEMBER
  STUDENT
  GUARDIAN
}

enum OnlineFormStatus {
  PENDING
  COMPLETED
  CANCELLED
}

/// Uzaktan form isteği. Form verisi kopyalanmaz; imza anında kaynak kayda (üye/öğrenci/veli) yazılır.
/// Burada yalnız kanıt kalır: onaylar, imza (şifreli), imzalayan adı, zaman ve içerik özeti (hash).
model OnlineFormRequest {
  id             String           @id @default(cuid())
  kind           OnlineFormKind
  subjectId      String
  /// "self" | "guardian" (reşit olmayan öğrenci: veli doldurur ve onaylar)
  signerRole     String
  /// Veli imzalıyorsa velinin kimliği
  signerId       String?
  /// Bağlantı belirtecinin SHA-256 özeti (belirtecin kendisi saklanmaz)
  tokenHash      String           @unique
  channel        String
  /// Maskeli alıcı (ör. a•••@example.org)
  sentTo         String
  status         OnlineFormStatus @default(PENDING)
  expiresAt      DateTime
  openedAt       DateTime?
  completedAt    DateTime?
  signerName     String?
  /// İmza görseli (PNG data URL), secret-box ile şifreli
  signatureEnc   String?
  consents       String[]         @default([])
  /// Onaylanan Datenschutz/fotoğraf metinlerinin SHA-256 özeti (hangi metin sürümü kabul edildi)
  textVersion    String?
  /// Benzersiz belge anahtarı (ör. ES-2026-7KQ4M2XA); imzalanınca verilir, PDF'te ve listede görünür
  documentKey    String?          @unique
  /// İmza anında üretilen PDF (base64), secret-box ile şifreli
  documentEnc    String?
  /// İmza anında gösterilen/girilen her şeyin şifreli anlık görüntüsü (PDF kanıt belgesi için; DSGVO Art. 7 (1) ispat)
  evidenceEnc    String?
  /// Uygulanan veri + onaylar + imzanın SHA-256 özeti (değiştirilmezlik kanıtı)
  evidenceHash   String?
  createdById    String
  createdByLabel String
  createdAt      DateTime         @default(now())

  @@index([kind, subjectId])
  @@index([status, expiresAt])
  @@map("online_form_requests")
}

enum OnlineFormDocumentPurpose {
  /// Datenschutz bilgilendirmesi: onay kutusu "privacy" onayıdır, her zaman zorunludur
  PRIVACY
  /// Fotoğraf/video izni: onay kutusu kaydın fotoğraf iznine yazılır
  PHOTO
  /// Diğer belgeler (ör. aidat yönetmeliği, ev kuralları)
  OTHER
}

/// Online formda gösterilen belge (zengin metin, Tiptap HTML; kaydederken ve gösterirken temizlenir).
model OnlineFormDocument {
  id              String                    @id @default(cuid())
  title           String
  purpose         OnlineFormDocumentPurpose @default(OTHER)
  contentHtml     String
  /// Altında onay kutusu gösterilsin mi (yalnız bilgi amaçlı belgeler için kapatılır)
  requiresConsent Boolean                   @default(true)
  /// Onay zorunlu mu (PRIVACY her zaman zorunlu sayılır)
  required        Boolean                   @default(false)
  appliesTo       OnlineFormKind[]          @default([MEMBER, STUDENT, GUARDIAN])
  sortOrder       Int                       @default(0)
  active          Boolean                   @default(true)
  updatedById     String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([active, sortOrder])
  @@map("online_form_documents")
}
