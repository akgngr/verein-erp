enum Role {
  ADMIN
  BOARD
  SECRETARY
  VIEWER
  TREASURER // Sayman (Faz 4 — muhasebe)
  AUDITOR // Denetçi (Faz 4 — denetim okuma)
  TEACHER // Öğretmen — yalnızca kurs ve öğrenci takibi modülleri
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role      @default(VIEWER)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  locale             String    @default("tr") // arayüz dili (de | tr)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}
