model Event {
  id          String    @id @default(uuid())
  title       String
  description String?
  type        String    @default("OTHER") // WORKSHOP, SEMINAR, SOCIAL, CULTURAL, SPORTS, OTHER
  status      String    @default("DRAFT") // DRAFT, PUBLISHED, COMPLETED, CANCELLED
  startDate   DateTime
  endDate     DateTime?
  location    String?
  isOnline    Boolean   @default(false)
  onlineUrl   String?
  capacity    Int? // null = sınırsız kontenjan
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  attendees EventAttendee[]

  @@index([status])
  @@index([startDate])
  @@index([type])
  @@map("events_items")
}

model EventAttendee {
  id           String   @id @default(uuid())
  eventId      String
  memberId     String? // Yumuşak referans (Soft reference)
  firstName    String
  lastName     String
  email        String?
  phone        String?
  status       String   @default("REGISTERED") // REGISTERED, ATTENDED, CANCELLED
  notes        String?
  registeredAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([memberId])
  @@index([status])
  @@map("events_attendees")
}
