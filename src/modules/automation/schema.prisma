enum AutomationExecutionKind {
  TASK
  WORKFLOW
}

enum AutomationExecutionStatus {
  PENDING
  RUNNING
  WAITING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AutomationStepStatus {
  PENDING
  RUNNING
  RETRYING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AutomationOutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

/// ERP-owned durable execution record. Queue transport metadata stays in pg-boss.
model AutomationExecution {
  id               String                    @id @default(cuid())
  kind             AutomationExecutionKind   @default(TASK)
  status           AutomationExecutionStatus @default(PENDING)
  definitionKey    String
  definitionVersion Int
  organizationId   String
  requestedById    String?
  sourceModule     String
  correlationId    String
  idempotencyKey   String?
  /// Only minimal identifiers and execution metadata; never persist recipient/PII lists here.
  input            Json                      @default("{}")
  context          Json                      @default("{}")
  attempt          Int                       @default(0)
  maxAttempts      Int                       @default(3)
  scheduledAt      DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  lastErrorCode    String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  steps            AutomationStepRun[]

  @@unique([organizationId, idempotencyKey])
  @@index([status, scheduledAt])
  @@index([sourceModule, createdAt])
  @@index([correlationId])
  @@map("automation_executions")
}

/// Per-step execution history. A retry updates the same logical step record.
model AutomationStepRun {
  id             String               @id @default(cuid())
  executionId    String
  stepKey        String
  taskKey        String
  taskVersion    Int
  status         AutomationStepStatus @default(PENDING)
  input          Json                 @default("{}")
  result         Json?
  attempt        Int                  @default(0)
  maxAttempts    Int                  @default(3)
  startedAt      DateTime?
  finishedAt     DateTime?
  lastErrorCode  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  execution      AutomationExecution  @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, stepKey])
  @@index([status, createdAt])
  @@map("automation_step_runs")
}

/// Transactional outbox. A later worker PR publishes pending rows to pg-boss.
model AutomationOutbox {
  id             String                 @id @default(cuid())
  eventKey       String                 @unique
  eventType      String
  executionId    String?
  payload        Json
  status         AutomationOutboxStatus @default(PENDING)
  attempts       Int                    @default(0)
  availableAt    DateTime               @default(now())
  publishedAt    DateTime?
  lastErrorCode  String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status, availableAt, createdAt])
  @@index([executionId])
  @@map("automation_outbox")
}
