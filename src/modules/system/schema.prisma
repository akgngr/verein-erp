// System modülü: dinamik modül durumu ve sistem ayarları tablosu

model SystemModuleState {
  id          String   @id @default(uuid())
  moduleKey   String   @unique
  isEnabled   Boolean  @default(true)
  settings    Json?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("system_module_states")
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

/// Kullanıcının panel düzeni: sıralı kart kimlikleri ("<modül>.<kart>"). Kayıt yoksa varsayılan kartlar gösterilir.
model SystemDashboardLayout {
  userId    String   @id // FK DEĞİL (yumuşak referans)
  cards     String[]
  updatedAt DateTime @updatedAt

  @@map("system_dashboard_layouts")
}

/// İmzalı modül paketi (.vmod) yüklemesi. Kurulum sunucuda değil, yönetici makinesinde/CI'da
/// `pnpm module:install <dosya>` ile yapılır (derleme gerektirir); burada doğrulama sonucu tutulur.
model SystemModulePackage {
  id            String   @id @default(cuid())
  moduleKey     String
  version       String
  name          String
  publisher     String
  category      String
  sha256        String   @unique
  size          Int
  verified      Boolean
  /// Doğrulama hata kodları (boş = geçerli)
  errors        String[]
  storagePath   String?
  uploadedById  String
  uploadedByLabel String
  createdAt     DateTime @default(now())

  @@index([moduleKey])
  @@map("system_module_packages")
}
