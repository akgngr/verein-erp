// System modülü: dinamik modül durumu ve sistem ayarları tablosu

model SystemModuleState {
  id          String   @id @default(uuid())
  moduleKey   String   @unique
  isEnabled   Boolean  @default(true)
  settings    Json?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("system_module_states")
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

/// Kullanıcının panel düzeni: sıralı kart kimlikleri ("<modül>.<kart>"). Kayıt yoksa varsayılan kartlar gösterilir.
model SystemDashboardLayout {
  userId    String   @id // FK DEĞİL (yumuşak referans)
  cards     String[]
  updatedAt DateTime @updatedAt

  @@map("system_dashboard_layouts")
}

/// İmzalı modül paketi (.vmod) yüklemesi. Kurulum sunucuda değil, yönetici makinesinde/CI'da
/// `pnpm module:install <dosya>` ile yapılır (derleme gerektirir); burada doğrulama sonucu tutulur.
model SystemModulePackage {
  id            String   @id @default(cuid())
  moduleKey     String
  version       String
  name          String
  publisher     String
  category      String
  sha256        String   @unique
  size          Int
  verified      Boolean
  /// Doğrulama hata kodları (boş = geçerli)
  errors        String[]
  storagePath   String?
  uploadedById  String
  uploadedByLabel String
  createdAt     DateTime @default(now())

  @@index([moduleKey])
  @@map("system_module_packages")
}

/// Dış veri çıkışı (egress) defteri (F2a): kategori, sağlayıcı, hacim/adet, hukuki dayanak ve modül.
/// Yük (payload) ve kişisel veri ASLA saklanmaz.
model SystemEgressLedger {
  id         String   @id @default(cuid())
  moduleKey  String
  category   String
  provider   String
  volume     Int      @default(0)
  count      Int      @default(1)
  unit       String   @default("requests")
  legalBasis String
  occurredAt DateTime @default(now())

  @@index([occurredAt])
  @@index([moduleKey, occurredAt])
  @@index([provider, occurredAt])
  @@map("system_egress_ledger")
}

/// Şifreli sistem yedeği (PostgreSQL + UPLOAD_DIR) ve geri yükleme doğrulama geçmişi (#617).
model SystemBackup {
  id                   String    @id @default(cuid())
  status               String
  trigger              String
  storagePath          String?
  archiveSizeBytes     Int       @default(0)
  archiveSha256        String?
  manifestSha256       String?
  dbMode               String?
  dbTableCount         Int       @default(0)
  dbRowCount           Int       @default(0)
  uploadFileCount      Int       @default(0)
  uploadTotalBytes     Int       @default(0)
  appVersion           String?
  schemaVersion        String?
  migrationCount       Int       @default(0)
  encryptionKeyVersion String?
  verifiedAt           DateTime?
  verificationStatus   String?
  verificationDetails  Json?
  errorCode            String?
  createdById          String?
  createdByLabel       String?
  createdAt            DateTime  @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
  @@map("system_backups")
}
