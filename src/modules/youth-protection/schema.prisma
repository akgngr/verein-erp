/// § 72a SGB VIII Çocuk ve Genç Koruma — Genişletilmiş Adli Sicil Belgesi (erweitertes Führungszeugnis)
/// İnceleme / İbraz Takibi.
/// YASAL VE GİZLİLİK SINIRI: DSGVO Art. 10 gereği ceza mahkûmiyeti / sabıka belgesi ASLA sisteme
/// yüklenemez ve saklanamaz (dosya yükleme teknik olarak engellenmiştir). Yalnızca yetkili yöneticinin
/// orijinal belgeyi fiziksel olarak gördüğü ve ibraz tarihi/fälligkeit kaydedilir.
model YouthProtectionRecord {
  id                   String   @id @default(cuid())
  personName           String
  memberId             String?
  userId               String?
  inspectionDate       DateTime
  certificateIssueDate DateTime
  inspectingOfficer    String
  nextDueDate          DateTime
  note                 String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([nextDueDate])
  @@index([personName])
  @@index([memberId])
  @@index([userId])
  @@map("youth-protection_records")
}
