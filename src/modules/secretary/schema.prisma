/// Kullanıcının sekreter tercihleri (T0.4). Kullanıcı başına tek satır.
model SecretaryPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  /// Günlük özet saati, Europe/Berlin "HH:mm".
  briefingTime   String   @default("07:30")
  briefingEnabled Boolean @default(true)
  /// Sessiz saatler "HH:mm"; ikisi de boşsa sessiz saat yok.
  quietFrom      String?
  quietTo        String?
  /// Bildirim kanalları: "in_app" | "email" (Pro: diğer kanallar).
  channels       String[] @default(["in_app"])
  /// Son günlük özetin Europe/Berlin tarihi "YYYY-MM-DD" (aynı gün tekrarı önler; T3.1).
  lastBriefingOn String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@map("secretary_preferences")
}

enum SecretaryItemStateKind {
  DISMISSED
  SNOOZED
}

/// Özet öğesinin kullanıcıya özel görünürlüğü. Kaynak kaydı değiştirmez ("gösterme" ≠ "tamamla").
model SecretaryItemState {
  id        String                 @id @default(cuid())
  userId    String
  /// BriefingItem.id ("<modül>:<tür>[:<kaynakId>]").
  itemId    String
  state     SecretaryItemStateKind
  /// SNOOZED için bitiş; DISMISSED için null.
  until     DateTime?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([userId, itemId])
  @@index([userId, until])
  @@map("secretary_item_states")
}

enum SecretaryProposalStatus {
  PENDING
  EXECUTING
  APPLIED
  FAILED
  DISMISSED
  EXPIRED
}

/// Sekreter önerisi (ADR 0005). İçerik şifreli; onay atomik claim ile; belirsiz yazma tekrarlanmaz.
model SecretaryProposal {
  id               String                  @id @default(cuid())
  userId           String
  /// "rule" | "model"
  source           String                  @default("rule")
  itemId           String?
  moduleKey        String
  actionKey        String
  payloadEnc       String
  previewEnc       String
  payloadHash      String
  preconditionsEnc String?
  status           SecretaryProposalStatus @default(PENDING)
  idempotencyKey   String                  @unique
  expiresAt        DateTime
  /// Kullanıcı öneriyi bu zamana kadar erteledi (onay kutusunda gizli; süre sonu değişmez). #296
  snoozedUntil     DateTime?
  confirmedAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime                @default(now())

  @@index([userId, status, expiresAt])
  @@map("secretary_proposals")
}

enum SecretaryFollowUpStatus {
  ACTIVE
  PAUSED
  DONE
  CANCELLED
  EXHAUSTED
}

/// S4.2 (#314): "benim yerime takip et". Kullanıcıya özel; başlık şifreli. Hatırlatma yalnız uygulama içi
/// (sekreter özeti); kaynak kayıt değiştirilmez, dış mesaj gönderilmez.
model SecretaryFollowUp {
  id             String                  @id @default(cuid())
  userId         String
  /// Kaynağı sahiplenen modül anahtarı ve onun yetkili sayfası (uygulama içi göreli yol).
  sourceModule   String
  sourceHref     String
  titleEnc       String
  /// Europe/Berlin takvim günü "YYYY-MM-DD" (yaz/kış saatinden bağımsız).
  dueOn          String
  status         SecretaryFollowUpStatus @default(ACTIVE)
  maxReminders   Int                     @default(3)
  reminderCount  Int                     @default(0)
  /// Son hatırlatmanın Berlin günü: aynı gün ikinci hatırlatma yok (yeniden başlatma/çift çalışma güvenli).
  lastRemindedOn String?
  /// PAUSED nedeni: "user" | "permission".
  pausedReason   String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([status, dueOn])
  @@index([userId, status])
  @@map("secretary_follow_ups")
}

/// S5.2 (#316): kullanıcının dış kanal rızası. Adres şifreli; doğrulama kodu yalnız hash. Geri alınınca adres silinir.
model SecretaryChannelConsent {
  id               String    @id @default(cuid())
  userId           String
  /// "telegram" | "whatsapp" | "sms"
  channel          String
  addressEnc       String?
  codeHash         String?
  codeExpiresAt    DateTime?
  codeAttempts     Int       @default(0)
  verifiedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, channel])
  @@map("secretary_channel_consents")
}

/// S5.2 (#316): dış kanal teslim kaydı (içerik yok). Kullanıcı+kanal+gün+tür benzersiz: çift gönderim yok.
model SecretaryChannelDelivery {
  id         String   @id @default(cuid())
  userId     String
  channel    String
  /// Europe/Berlin günü "YYYY-MM-DD".
  day        String
  /// "daily-digest" | "verification"
  kind       String
  status     String   @default("PENDING") // PENDING | SENT | FAILED
  attempts   Int      @default(0)
  providerId String?
  errorCode  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, channel, day, kind])
  @@index([userId, channel, day])
  @@map("secretary_channel_deliveries")
}
