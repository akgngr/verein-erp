# Verein ERP — örnek ortam değişkenleri
# Kopyalayın:  cp .env.example .env   ve değerleri doldurun.
# Doğrulama: src/shared/env.ts (eksik/geçersiz değerde uygulama açıklayıcı hatayla durur).

# ---------------------------------------------------------------------------
# Zorunlu
# ---------------------------------------------------------------------------

# PostgreSQL bağlantı adresi
DATABASE_URL="postgresql://KULLANICI:PAROLA@localhost:5432/dernek"
# Neon gibi havuzlu (pooled) bağlantıda migration için havuzsuz adres (isteğe bağlı; yoksa DATABASE_URL).
# DIRECT_URL="postgresql://KULLANICI:PAROLA@ep-xxx.eu-central-1.aws.neon.tech/dernek?sslmode=require"

# Oturum imzalama anahtarı (en az 16 karakter). Üretmek için: openssl rand -base64 32
# DİKKAT: E-posta modülündeki SMTP şifresi bu anahtardan türetilen anahtarla şifrelenir;
# değiştirilirse kayıtlı SMTP şifresinin yeniden girilmesi gerekir.
AUTH_SECRET=""

# Reverse proxy (Caddy/nginx) arkasında veya sunucuda çalışırken true
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# Dosya depolama
# ---------------------------------------------------------------------------

# Yüklenen dosyaların klasörü. Üretimde mutlak yol + kalıcı volume (Docker: /app/storage/uploads)
UPLOAD_DIR="./storage/uploads"
# Dosya başına en fazla boyut (MB)
MAX_UPLOAD_MB=20

# ---------------------------------------------------------------------------
# Belgeler
# ---------------------------------------------------------------------------

# Dernek profili kaydedilmemişse PDF antetinde kullanılan geçici ad
ORGANIZATION_NAME="Musterverein e. V."
# Resmi PDF'lerin varsayılan dili: de | tr
DOCUMENT_LANGUAGE=de

# ---------------------------------------------------------------------------
# İlk yönetici (yalnızca `pnpm db:seed` için)
# Parola kuralı: en az 10 karakter, 1 büyük harf, 1 küçük harf, 1 rakam.
# İlk girişte parola değişikliği zorunludur.
# ---------------------------------------------------------------------------

ADMIN_EMAIL="admin@verein.example"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"

# ---------------------------------------------------------------------------
# İsteğe bağlı
# ---------------------------------------------------------------------------

# E-posta modülü: SMTP şifresini şifreleme anahtarı (boşsa AUTH_SECRET kullanılır)
# MAIL_ENCRYPTION_KEY=""

# Server Actions için ek izinli kaynaklar (virgülle ayrılmış). Standart reverse proxy
# kurulumunda GEREKMEZ. Yalnızca proxy Host başlığını değiştiriyorsa kullanın.
# DİKKAT: Derleme anında okunur (Docker: build arg olarak verin).
# SERVER_ACTIONS_ALLOWED_ORIGINS="verein.example.de"

# Yalnızca geliştirme: localhost dışındaki dev erişim adresleri (örn. LAN IP, tünel)
# DEV_ALLOWED_ORIGINS="192.168.1.20"

# Caddyfile (reverse proxy) için
# APP_DOMAIN="verein.example.de"
# APP_UPSTREAM="localhost:3000"

# Yapay zekâ asistanı: sağlayıcı ve API anahtarları Ayarlar → Yapay zekâ asistanı sayfasından
# girilir; anahtarlar AUTH_SECRET ile şifrelenerek veritabanında saklanır (ortam değişkeni gerekmez).
